# Example environment variables for the THB Corporate Gifting Portal.
# Copy this file to `.env.local` and fill in real values. Never commit real secrets.
#
# .env.local (and all other .env / .env.* files) are git-ignored; only this
# template is tracked so teammates know which variables are expected.

# --- App ---
# Public base URL of the app (used for absolute links and auth callbacks).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Supabase ---
# All three come from the Supabase dashboard: Project Settings -> API Keys.
# Uses the NEW Supabase API key system (publishable / secret), not the legacy
# anon / service_role JWT keys.

# Project URL, e.g. https://abcdefgh.supabase.co  (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key, starts with "sb_publishable_"  (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key, starts with "sb_secret_"  (SERVER-ONLY — never sent to the browser)
SUPABASE_SECRET_KEY=

# --- Supabase CLI (local tooling only — NOT used by the running app) ---
# Needed to apply database migrations with `npm run db:push`. The db:* scripts
# read these from .env.local. Treat both like passwords; never commit real values.
#
# Personal Access Token: Dashboard -> Account -> Access Tokens -> generate.
SUPABASE_ACCESS_TOKEN=
# Postgres database password: Dashboard -> Project Settings -> Database.
SUPABASE_DB_PASSWORD=

# --- Stripe (payments — TEST MODE) ---
# Use TEST keys only while building. Both are SERVER-ONLY; never expose to the
# browser. Hosted Checkout redirects from the server, so NO publishable key is
# needed. Get keys at https://dashboard.stripe.com (toggle "Test mode" ON).
#
# Secret key (test): Developers -> API keys -> "Secret key" (starts "sk_test_").
STRIPE_SECRET_KEY=
# Webhook signing secret (test): printed by `stripe listen` for local dev, or
# Developers -> Webhooks -> your endpoint -> "Signing secret" (starts "whsec_").
STRIPE_WEBHOOK_SECRET=
